# Строка подключения к PostgreSQL
DATABASE_URL=postgres://dom:CHANGE_ME@localhost:5444/dom?sslmode=disable
LISTEN_ADDR=:8080
SESSION_TTL=24h
ADMIN_USERNAME=admin
# bcrypt-хеш: go run ./cmd/hashpw <пароль>. В .env для docker compose каждый $ удваивается: $$
ADMIN_PASSWORD_HASH=
# Случайная строка для подписи cookie-сессии
ADMIN_SESSION_SECRET=
# Необязательно: журнал ещё и в файл с ротацией (20 МБ, 10 файлов, 90 дней). В docker compose задан в docker-compose.yml.
# LOG_FILE=./logs/dom-backend.log

# Sber API (необязательно): получение выписок напрямую из банка. Пока SBER_CLIENT_ID пуст, интеграция выключена.
# SBER_CLIENT_ID=
# SBER_CLIENT_SECRET_FILE=./secrets/client_secret
# SBER_TLS_P12=./secrets/tls.p12
# SBER_TLS_P12_PASSWORD_FILE=./secrets/tls.pass
# SBER_CA_DIR=./certs/sber   # публичные сертификаты Сбера из репозитория (в образе: /etc/sber-ca)
# SBER_SYNC_AT=01:00      # во сколько раз в сутки опрашивать банк; off = только по кнопке
# SBER_SYNC_TZ=Europe/Moscow
# SBER_SYNC_DAYS=3        # сколько последних дней перезапрашивает опрос по расписанию
