# Строка подключения к PostgreSQL
DATABASE_URL=postgres://dom:CHANGE_ME@localhost:5444/dom?sslmode=disable
LISTEN_ADDR=:8080
SESSION_TTL=24h
ADMIN_USERNAME=admin
# bcrypt-хеш: go run ./cmd/hashpw <пароль>. В .env для docker compose каждый $ удваивается: $$
ADMIN_PASSWORD_HASH=
# Случайная строка для подписи cookie-сессии
ADMIN_SESSION_SECRET=
# Необязательно: журнал ещё и в файл с ротацией (20 МБ, 10 файлов, 90 дней). В docker compose задан в docker-compose.yml.
# LOG_FILE=./logs/dom-backend.log
